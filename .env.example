# PrintXpress Environment Configuration
# If Supabase credentials are provided, the app connects to Supabase database & storage.
# If left empty, PrintXpress seamlessly runs in resilient Local Demo mode with persistent localStorage.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
